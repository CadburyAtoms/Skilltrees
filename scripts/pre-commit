#!/usr/bin/env bash
# Git pre-commit hook — blocks commits that include malformed data/*.json.
#
# Install this hook with:
#   bash scripts/install-hooks.sh
#
# Skip with `git commit --no-verify` if you ever need to bypass it.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Only run if any data/*.json file is staged.
if git diff --cached --name-only | grep -q '^data/.*\.json$'; then
  if command -v node >/dev/null 2>&1; then
    echo "[pre-commit] running JSON validation…"
    if ! node "$REPO_ROOT/scripts/validate.js"; then
      echo "[pre-commit] commit blocked — fix the errors above, or use --no-verify to override." >&2
      exit 1
    fi
  else
    echo "[pre-commit] Node not on PATH — skipping local validation." >&2
    echo "  GitHub Actions will validate on push. Install Node 20 LTS to validate locally." >&2
  fi
fi

# Dashboard source-doc changes: the generated dashboard must match its sources.
if git diff --cached --name-only | grep -qE '^(EDHA_FOUNDRY_TEST_CHECKLIST\.md|EDHA_ADVERSARY_ART_WISHLIST\.md|TODO_WORLDBUILDING\.md|TODO_REPO_HYGIENE\.md|EDHA_CAMPAIGN_CANON\.md|EDHA_CAMPAIGN_STATE\.md|EDHA_FOUNDRY_HANDOFF\.md|TRIAGE_PLAYTEST_PC_MANUALS\.md|FORCED_MOVEMENT_PILOT\.md|source-materials/maps/thyrcross\.map\.json|EDHA_DASHBOARD\.html|scripts/build-dashboard\.js)$'; then
  if command -v node >/dev/null 2>&1; then
    echo "[pre-commit] checking the dashboard is in sync with its source docs…"
    if ! node "$REPO_ROOT/scripts/build-dashboard.js" --check; then
      echo "[pre-commit] commit blocked — run 'node scripts/build-dashboard.js' and stage the regenerated dashboard." >&2
      exit 1
    fi
  fi
fi

# Engine or authored-overlay changes: cross-reference lint + engine helper tests.
if git diff --cached --name-only | grep -qE '^(module-src/scripts/register-skills\.js|data/authored/.*\.json|scripts/lint-refs\.js|tests/)'; then
  if command -v node >/dev/null 2>&1; then
    echo "[pre-commit] running lint-refs + engine tests…"
    if ! node "$REPO_ROOT/scripts/lint-refs.js" || ! node "$REPO_ROOT/tests/run.js"; then
      echo "[pre-commit] commit blocked — fix the errors above, or use --no-verify to override." >&2
      exit 1
    fi
  fi
fi
