.claude/*
!.claude/skills/
.codex/

# Local OS/editor noise
Thumbs.db
Desktop.ini
*.swp
*.tmp
*.temp

# Local-only generated exports and scratch artifacts
exports/
tmp/
*.local.*
scripts/build-log.txt

# Per-machine build guard cache (records the on-disk pack fingerprint so the
# builder can refuse to overwrite un-extracted Foundry edits). NOT source.
data/authored/.baselines/

# Python bytecode (audit.py imported by tests)
__pycache__/

# No committed binaries (repo review 2026-07-06): reference PDFs and pasted
# screenshots stay out of git — especially third-party/copyrighted material.
# Runtime image assets, if ever needed, get an explicit !-exception here.
*.pdf
source-materials/**/*.png
